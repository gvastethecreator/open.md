# Lumen Harbor Station  ·  last-watch environment
# Loaded by the pier daemon. Not secrets. The rain already knows.

HARBOR_NAME=Lumen Harbor
HARBOR_ID=LH-00
HARBOR_WATCH=last
HARBOR_CLOUD=false
HARBOR_LOCALE=en_GB.UTF-8

# lamp
HARBOR_LAMP_ID=4
HARBOR_LAMP_FUEL=kerosene
HARBOR_LAMP_WICK_MM=7
HARBOR_LAMP_FUEL_ML=390
HARBOR_LAMP_TRIMMED=true
HARBOR_LAMP_TRIMMED_AT=2026-08-26T02:10:00Z

# weather
HARBOR_FOG_METERS=62
HARBOR_TIDE_CM=184
HARBOR_TIDE_PHASE=flood
HARBOR_RAIN=vertical
HARBOR_WIND_KT=11
HARBOR_WIND_FROM=WSW

# census
HARBOR_MOTHS=14
HARBOR_MOTH_NAMED=Ida,Percival,Little Noise,Glass-Eater
HARBOR_UNREAD_LETTERS=14
HARBOR_CHAIRS=1
HARBOR_CHAIR_OCCUPIED=false

# radio
HARBOR_RADIO_CHANNEL=ch-4
HARBOR_RADIO_CALLSIGN=LH-00
HARBOR_RADIO_FREQ_KHZ=2182
HARBOR_RADIO_LAST_HEARD=number

# paths (local only)
HARBOR_ROOT=.
HARBOR_NOTEBOOK=./a-quiet-place.md
HARBOR_BIBLE=./lumen-harbor.markdown
HARBOR_LOG=./overnight.log
HARBOR_TIDE_CSV=./tide-log.csv
HARBOR_NFO_PROGRAM=./lumen-station.nfo
HARBOR_NFO_KODI=./kodi-the-quiet-place.nfo
HARBOR_NFO_MSINFO=./windows-msinfo.nfo

# quoted values the highlighter should keep as strings
HARBOR_TAGLINE="The document is the interface."
HARBOR_COFFEE="café, naïve, 東京"
HARBOR_EMPTY=" "

# the daemon refuses these
# HARBOR_API_KEY=do-not-put-real-keys-in-examples
HARBOR_TELEMETRY_URL=
HARBOR_ACCOUNT=
