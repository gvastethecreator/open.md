{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "📦 deps",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "install"
      ],
      "group": "none"
    },
    {
      "label": "⚡ web",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "run",
        "dev"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "🚀 dev",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "run",
        "tauri",
        "dev"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "🧪 test",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "run",
        "test:frontend"
      ],
      "group": "test"
    },
    {
      "label": "🦀 test",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "run",
        "test:rust"
      ],
      "group": "test"
    },
    {
      "label": "🔍 check",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "run",
        "check:frontend"
      ],
      "group": "test"
    },
    {
      "label": "✅ verify",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "run",
        "verify"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "🏗️ build",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "run",
        "tauri",
        "build"
      ],
      "dependsOn": [
        "✅ verify"
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
