{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "📦 deps",
      "type": "shell",
      "command": "pnpm",
      "args": ["install"],
      "problemMatcher": []
    },
    {
      "label": "📊 outdated",
      "type": "shell",
      "command": "pnpm",
      "args": ["outdated"],
      "problemMatcher": []
    },
    {
      "label": "⚡ web",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "dev"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "🚀 tauri",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "tauri", "dev"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "🧹 static",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "check:static"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "📄 pages",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "check:pages"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "🧪 front",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "test:frontend"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "🎨 Rust fmt",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "fmt:rust"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "🦀 Rust test",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "test:rust"],
      "group": "test",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "🔍 check",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "check:frontend"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "✅ verify",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "verify"],
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "🏗️ build",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "tauri", "build"],
      "dependsOn": ["✅ verify"],
      "dependsOrder": "sequence",
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": []
    }
  ]
}
