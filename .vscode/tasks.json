{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "▶️ Dev",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "dev"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "🚀 Tauri Dev",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "tauri", "dev"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "🧪 Test",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "test:frontend"],
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "🦀 Rust Test",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "test:rust"],
      "group": "test",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "🔍 Check",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "check:frontend"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "🧹 Static",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "check:static"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "📄 Pages",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "check:pages"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "🎨 Rust Fmt",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "fmt:rust"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "🦀 Rust Check",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "check:rust"],
      "group": "test",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "✅ Verify",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "verify"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "🏗️ Build",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "tauri", "build"],
      "dependsOn": ["✅ Verify"],
      "dependsOrder": "sequence",
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "📦 Store Validate",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "store:validate"],
      "problemMatcher": []
    },
    {
      "label": "🎨 Themes",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "generate:themes"],
      "problemMatcher": []
    },
    {
      "label": "📦 Install",
      "type": "shell",
      "command": "pnpm",
      "args": ["install"],
      "problemMatcher": []
    },
    {
      "label": "📊 Outdated",
      "type": "shell",
      "command": "pnpm",
      "args": ["outdated"],
      "problemMatcher": []
    }
  ]
}
