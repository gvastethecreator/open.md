{
  "name": "open-md",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "type": "module",
  "description": "Minimalist local Markdown/text reader and editor built with Tauri v2, Rust and Vite.",
  "license": "MIT",
  "author": {
    "name": "gvastethecreator",
    "url": "https://github.com/gvastethecreator"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gvastethecreator/open.md.git"
  },
  "homepage": "https://gvastethecreator.github.io/open.md/",
  "bugs": {
    "url": "https://github.com/gvastethecreator/open.md/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node ./scripts/check-bundle.mjs",
    "check:bundle": "node ./scripts/check-bundle.mjs",
    "check:pages": "node ./scripts/validate-pages.mjs",
    "generate:themes": "node ./scripts/generate-runtime-themes.mjs",
    "tauri": "tauri",
    "test:frontend": "vitest run",
    "check:static": "node ./scripts/validate-frontend.mjs",
    "check:shell": "vitest run src/reader-shell.test.js",
    "check:frontend": "pnpm run check:static && pnpm run check:shell && pnpm run check:pages",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "fmt:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "verify": "pnpm run check:frontend && pnpm run test:frontend && pnpm run build && pnpm run fmt:rust && pnpm run check:rust && pnpm run test:rust",
    "store:validate": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/store/Test-StoreReadiness.ps1",
    "store:build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/store/Build-StoreInstaller.ps1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "jsdom": "30.0.1",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@chenglou/pretext": "0.0.8",
    "@tabler/icons": "^3.46.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "highlight.js": "11.12.0",
    "iconoir": "^7.12.1",
    "mermaid": "^11.17.0"
  },
  "overrides": {
    "dompurify": "3.4.13",
    "lodash-es": "4.18.1",
    "picomatch": "4.0.5",
    "uuid": "11.1.1"
  }
}
